# DATABASE_URL is required. Keep exactly one line active; to switch, comment one and uncomment the other.
# (If both are active, the last one silently wins.)

# Local development (SQLite file in this folder):
DATABASE_URL=sqlite:///registry.db

# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/registry

# Plot photos (S3). Credentials are not set here: boto3 finds them (~/.aws, or the instance role).
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-name-agropilot-photos
